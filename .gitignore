__pycache__/
*.py[cod]
*.npz
*.npy
*.log
.venv/
build/
dist/
outputs/
data/
predictions/
*.egg-info/
# Keep the standalone release complete even inside the research root's broad
# ignores for text, JSON and test files.
!requirements.txt
!docs/source_provenance.json
!docs/*.md
!scripts/*.py
!config/fusion_config.yaml
!licenses/*.txt
!tests/test_*.py
!examples/axl2_fish/README.md
!examples/axl2_fish/input.npz
!examples/axl2_fish/mesh.obj
!examples/axl2_fish/preview.png
!examples/axl2_fish/provenance.json
